{
  "name": "alrajhi-contractor-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --minify --format=esm --jsx=automatic --outfile=public/app.js",
    "dev": "node scripts/dev.mjs",
    "deploy": "node scripts/deploy.mjs",
    "migrate": "wrangler d1 migrations apply DB --remote",
    "test": "node --test tests/worker.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "wrangler": "4.92.0"
  }
}
