{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contractor-portal",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contractor-portal-db",
      "migrations_dir": "migrations"
    }
  ],
  "keep_vars": true,
  "workers_dev": true
}
